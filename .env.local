# Copy this file to .env.local (for your Mac) and add the same values in Vercel:
# Project → Settings → Environment Variables. Values come from Firebase:
# Project settings → Your apps → Web app → SDK setup and configuration → Config.
#
# Leave them empty to run in demo mode (everything stays in one browser).

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAek3GALTk-1p5L9XON2VR9nHfy9IBgulA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kavach-breach-room.firebaseapp.com
# Singapore databases look like: https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://kavach-breach-room-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kavach-breach-room
NEXT_PUBLIC_FIREBASE_APP_ID=kavach-breach-room

# Optional: the PIN for demo mode only (default 3010). Not used once Firebase is connected.
NEXT_PUBLIC_DEMO_PIN=3010
